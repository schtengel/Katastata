<Window x:Class="Katastata.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="О программе" Height="520" Width="520"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24">
            <Image Source="/Assets/Logo/MainLogo.png" Width="72" Height="72" HorizontalAlignment="Left"/>
            <TextBlock Text="Katastata" FontSize="28" FontWeight="SemiBold" Margin="0,12,0,0"/>
            <TextBlock Text="Версия 1.0" Foreground="{DynamicResource DisabledBrush}" Margin="0,4,0,16"/>
            <TextBlock TextWrapping="Wrap" LineHeight="22"
                       Text="Мониторинг программ на этом компьютере: сессии, общее время, категории и экспорт отчёта."/>
            <TextBlock Text="Как пользоваться" FontWeight="SemiBold" Margin="0,18,0,8"/>
            <TextBlock TextWrapping="Wrap" LineHeight="22"
                       Text="1. Войдите или зарегистрируйтесь.&#x0a;2. Нажмите «Обновить», чтобы найти программы.&#x0a;3. Откройте плитку — там сессии и категория.&#x0a;4. В настройках создайте категории и выгрузите отчёт.&#x0a;5. Закрытие окна сворачивает приложение в трей."/>
            <TextBlock Text="Автор" FontWeight="SemiBold" Margin="0,18,0,8"/>
            <TextBlock TextWrapping="Wrap"
                       Text="Муслимов Эльмир. Курсовая: C#, WPF, MVVM."/>
        </StackPanel>
    </ScrollViewer>
</Window>