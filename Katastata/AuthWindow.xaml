<Window x:Class="Katastata.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация"
        Height="640" Width="540"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="/Assets/Logo/MainLogo.png"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True">
    <Border CornerRadius="8"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            Background="{DynamicResource WindowBackgroundBrush}"
            Margin="8">
        <Grid>
            <Grid x:Name="RootGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Background="Transparent" MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                    <TextBlock Text="Katastata"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextForegroundBrush}"/>
                    <Button Content="✕"
                            Width="36" Height="32"
                            Style="{StaticResource ThemeSymbolButtonStyle}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,4,0"
                            Click="CloseApp"/>
                </Grid>

                <StackPanel Grid.Row="1" Margin="32,12,32,0">
                    <TextBlock Text="Добро пожаловать"
                               FontSize="28" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextForegroundBrush}"/>
                    <TextBlock Text="Войдите или создайте аккаунт, чтобы видеть свою статистику."
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource DisabledBrush}"/>
                </StackPanel>

                <Border Grid.Row="2" Margin="32,20,32,8">
                    <ContentControl x:Name="ContentArea"/>
                </Border>

                <Grid Grid.Row="3" Margin="32,8,32,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="LoginButton"
                            Content="Вход"
                            Height="36"
                            Style="{StaticResource ThemeButtonStyle}"
                            Width="Auto"
                            HorizontalAlignment="Stretch"
                            Click="ShowLoginPage"/>
                    <Button x:Name="RegisterButton"
                            Grid.Column="2"
                            Content="Регистрация"
                            Height="36"
                            Style="{StaticResource ThemeButtonStyle}"
                            Width="Auto"
                            HorizontalAlignment="Stretch"
                            Click="ShowRegisterPage"/>
                </Grid>
            </Grid>

            <Grid x:Name="SuccessOverlay"
                  Background="{DynamicResource WindowBackgroundBrush}"
                  Opacity="0"
                  Visibility="Collapsed">
                <TextBlock x:Name="SuccessText"
                           Text="Успешная авторизация"
                           Foreground="{DynamicResource TextForegroundBrush}"
                           FontSize="24" FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</Window>