<Window x:Class="Katastata.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Экспорт" Height="180" Width="360"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/Logo/MainLogo.png"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStyle="None">
    <Border BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" CornerRadius="8" Margin="8">
        <StackPanel Margin="20" VerticalAlignment="Center">
            <TextBlock Text="Формат экспорта" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextForegroundBrush}" Margin="0,0,0,14"/>
            <UniformGrid Columns="2">
                <Button Content="Word" Margin="0,0,6,0" Height="36"
                        Style="{DynamicResource ThemeButtonStyle}" Width="Auto"
                        HorizontalAlignment="Stretch" Click="Word_Click"/>
                <Button Content="Excel" Margin="6,0,0,0" Height="36"
                        Style="{DynamicResource ThemeButtonStyle}" Width="Auto"
                        HorizontalAlignment="Stretch" Click="Excel_Click"/>
            </UniformGrid>
        </StackPanel>
    </Border>
</Window>