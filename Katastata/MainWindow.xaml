<Window x:Class="Katastata.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Katastata.Helpers"
        Title="Katastata"
        Width="1100" Height="700"
        MinWidth="860" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Icon="/Assets/Logo/MainLogo.png"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip">

    <Grid>
        <Border Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Height="48"
                VerticalAlignment="Top"
                MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
            <Grid Margin="16,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0"
                       Source="/Assets/Logo/TextLogo.png"
                       Height="22"
                       VerticalAlignment="Center"
                       Stretch="Uniform"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="LogoutBtn"
                            Content="Выйти"
                            Style="{DynamicResource ThemeSymbolButtonStyle}"
                            Width="72"
                            ToolTip="Выйти с аккаунта"
                            Click="Logout_Click"/>
                    <Button x:Name="LightThemeBtn"
                            Content="☀"
                            ToolTip="Светлая тема"
                            Style="{DynamicResource ThemeSymbolButtonStyle}"
                            Click="LightTheme_Click"/>
                    <Button x:Name="DarkThemeBtn"
                            Content="🌙"
                            ToolTip="Темная тема"
                            Style="{DynamicResource ThemeSymbolButtonStyle}"
                            Click="DarkTheme_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Button Content="—" Style="{DynamicResource ThemeSymbolButtonStyle}" Click="Minimize_Click"/>
                    <Button x:Name="FullscreenBtn" Content="🗖" Style="{DynamicResource ThemeSymbolButtonStyle}" Click="FullscreenBtn_Click"/>
                    <Button Content="✕" Style="{DynamicResource ThemeSymbolButtonStyle}" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="20,64,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Обновить"
                            Command="{Binding ScanCommand}"
                            Style="{DynamicResource ThemeButtonStyle}"
                            Width="120"
                            Click="ScannerBtn_Click"/>
                    <TextBlock x:Name="ScanText"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="#FF107C10"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="CategoryFilterCombo"
                              Width="180" Height="32"
                              Margin="0,0,8,0"
                              ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategory, UpdateSourceTrigger=PropertyChanged}"
                              DisplayMemberPath="Name"
                              Style="{StaticResource ThemeComboBoxStyle}"
                              VerticalAlignment="Center"/>
                    <Button x:Name="SortByNameBtn"
                            Content="Ab"
                            Style="{StaticResource ThemeSymbolButtonStyle}"
                            ToolTip="Сортировка по имени"
                            Click="SortByName_Click"/>
                    <Button x:Name="SortByLastLaunchBtn"
                            Content="🕒"
                            Style="{StaticResource ThemeSymbolButtonStyle}"
                            ToolTip="Сортировка по последнему запуску"
                            Click="SortByLastLaunch_Click"/>
                    <Button Content="⚙"
                            Command="{Binding OpenSettingsCommand}"
                            Style="{DynamicResource ThemeSymbolButtonStyle}"
                            ToolTip="Настройки"/>
                    <Button Content="?"
                            Command="{Binding OpenAboutCommand}"
                            Style="{StaticResource ThemeSymbolButtonStyle}"
                            ToolTip="О программе"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="Transparent">
                <Border.Resources>
                    <Style TargetType="Border" x:Key="ProgramTileStyle">
                        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                        <Setter Property="CornerRadius" Value="8"/>
                        <Setter Property="Padding" Value="12"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Resources>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <ItemsControl ItemsSource="{Binding Programs}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal"
                           Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollContentPresenter}}"/>
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border Style="{DynamicResource ProgramTileStyle}"
                        MouseLeftButtonDown="ProgramTile_MouseLeftButtonDown"
                        Width="220"
                        Height="120"
                        Margin="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Width="48" Height="48" Margin="0,0,12,0"
                               VerticalAlignment="Center">
                            <Image.Source>
                                <Binding Path="Path" Converter="{StaticResource PathToIconConverter}"/>
                            </Image.Source>
                        </Image>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}"
                                       Foreground="{DynamicResource TextForegroundBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="140"/>
                            <TextBlock Text="{Binding Category.Name}"
                                       Foreground="{DynamicResource DisabledBrush}"
                                       FontSize="11"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>