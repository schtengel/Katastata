<Window x:Class="Katastata.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки"
        Height="780" Width="780"
        MinHeight="480" MinWidth="560"
        Icon="/Assets/Logo/MainLogo.png"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextForegroundBrush}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
        <StackPanel MaxWidth="680">
            <TextBlock Text="Настройки" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Text="Категории, экспорт и аккаунт" Foreground="{DynamicResource DisabledBrush}" Margin="0,0,0,16"/>

            <Border Style="{StaticResource StatisticCardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Категории" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="Новая категория появится в фильтре и в карточке программы."
                               Foreground="{DynamicResource DisabledBrush}" Margin="0,4,0,12" TextWrapping="Wrap"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NewCategoryName"
                                 Style="{StaticResource ThemeTextBoxStyle}"
                                 Tag="Название категории"/>
                        <Button Grid.Column="1" Content="Создать"
                                Style="{StaticResource ThemeButtonStyle}"
                                Width="110" Margin="8,0,0,0"
                                CommandParameter="{Binding Text, ElementName=NewCategoryName}"
                                Command="{Binding CreateCategoryCommand}"/>
                    </Grid>
                    <ListBox Margin="0,12,0,0"
                             ItemsSource="{Binding Categories}"
                             BorderThickness="0"
                             Background="Transparent"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="×"
                                            Style="{StaticResource ThemeSymbolButtonStyle}"
                                            ToolTip="Удалить категорию"
                                            Command="{Binding DataContext.DeleteCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Id}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatisticCardStyle}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Экспорт" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Отчёт по программам в Word или Excel."
                                   Foreground="{DynamicResource DisabledBrush}" Margin="0,4,16,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Экспортировать"
                            Style="{StaticResource ThemeButtonStyle}" Width="150"
                            VerticalAlignment="Center" Click="Export_Click"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource StatisticCardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Общая информация" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <UniformGrid Columns="2">
                        <Button Content="Статистика" Margin="0,0,6,0"
                                Style="{StaticResource ThemeButtonStyle}" Width="Auto"
                                HorizontalAlignment="Stretch" Click="OpenStatistics_Click"/>
                        <Button Content="Сессии" Margin="6,0,0,0"
                                Style="{StaticResource ThemeButtonStyle}" Width="Auto"
                                HorizontalAlignment="Stretch" Click="OpenSessions_Click"/>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatisticCardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Тема" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <UniformGrid Columns="2">
                        <Button Content="Светлая" Margin="0,0,6,0"
                                Style="{StaticResource ThemeButtonStyle}" Width="Auto"
                                HorizontalAlignment="Stretch" Click="LightTheme_Click"/>
                        <Button Content="Тёмная" Margin="6,0,0,0"
                                Style="{StaticResource ThemeButtonStyle}" Width="Auto"
                                HorizontalAlignment="Stretch" Click="DarkTheme_Click"/>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatisticCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Аккаунт" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Удаление сотрёт все сессии и статистику этого пользователя."
                                   Foreground="{DynamicResource DisabledBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Удалить аккаунт"
                            Style="{StaticResource ThemeButtonStyle}"
                            Background="#FFC42B1C" Foreground="White" Width="160"
                            VerticalAlignment="Center" Click="DeleteAccount_Click"/>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>